# Copy to .env and edit. .env is gitignored; this file is the committed template.
#
# Anything already set in your shell overrides what is here, so you can try a
# single run differently without editing:
#
#   OLLAMA_BASE_URL=http://gpubox.lan:11434 claude-ollama

# --- Ollama ---------------------------------------------------------------
# Where Ollama listens. Its own default port is 11434.
OLLAMA_BASE_URL=http://localhost:11434

# Seconds to wait on a request. Local models on CPU can be very slow. This also
# becomes Claude Code's API_TIMEOUT_MS.
CLAUDE_OLLAMA_TIMEOUT=600

# --- Models ---------------------------------------------------------------
# Used for Claude Code's main requests.
CLAUDE_OLLAMA_MODEL=ornith-1.5:9b
# Used for its cheap background calls (conversation titles and the like).
CLAUDE_OLLAMA_SMALL_MODEL=ornith-1.5:9b
# More models to offer in Claude Code's /model picker, beside CLAUDE_OLLAMA_MODEL
# (which is always listed first and is what a session starts on). Comma or space
# separated. Each must be pulled; the launcher checks. All share NUM_CTX below.
CLAUDE_OLLAMA_MODELS=

# --- Generation -----------------------------------------------------------
# Context window requested from Ollama. Ollama's own default is 4096, which is
# far too small: Claude Code's system prompt and tool schemas run to roughly
# 12-15k tokens before your conversation starts. Do not go below ~16384.
#
# qwen3.5 is 256K-native, so the ceiling is your VRAM, not the model: this
# allocates KV cache whether or not the conversation fills it.
#
# 32768 is NOT enough for agentic work: Claude Code's system prompt and tool
# schemas take roughly 15k of it, leaving too little room for a file read, so
# auto-compaction thrashes (it reports "Autocompact is thrashing"). 65536 is the
# practical floor; Ollama's own docs say coding tools want 64k or more.
#
# On a 16GB card a 9B model at Q4_K_M (6.5GB of weights) only reaches 65536 with
# KV quantization on the server:
#   OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0
# Verify with `ollama ps` — PROCESSOR must read 100% GPU. Any CPU split means the
# window is too large for the card and the slowdown will be severe.
CLAUDE_OLLAMA_NUM_CTX=65536

# Most tokens one reply may produce; becomes Claude Code's
# CLAUDE_CODE_MAX_OUTPUT_TOKENS. Claude Code reserves this much of the window
# (capped at 20000) plus a fixed 13000, and auto-compacts at what is left:
#   65536 - 8192  - 13000 = 44344  (68% of the window)
#   65536 - 20000 - 13000 = 32536  (50%, what its default of 32000 gives)
# Lower compacts later; but a reply, including a file written in one tool call,
# is cut off at this length.
CLAUDE_OLLAMA_MAX_OUTPUT=8192

CLAUDE_OLLAMA_TEMPERATURE=0.0

# off = send think=false (fastest), on = send think=true, auto = omit the field.
# Models that reject the field fall back to auto on their own.
CLAUDE_OLLAMA_THINKING=off

# Strip <think>...</think> spans that leak into ordinary replies.
CLAUDE_OLLAMA_STRIP_THINKING=true

# Log every raw line Ollama returns, for working out why a turn did nothing.
CLAUDE_OLLAMA_DEBUG=false

# --- Proxy ----------------------------------------------------------------
# Where this proxy listens; Claude Code is pointed here via ANTHROPIC_BASE_URL.
CLAUDE_OLLAMA_HOST=127.0.0.1
CLAUDE_OLLAMA_PORT=8765
