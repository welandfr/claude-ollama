#!/usr/bin/env bash
# Starts the proxy if it is not already running, then launches Claude Code
# pointed at it. Any arguments are passed through to claude.
#
# Safe to symlink onto your PATH and run from any project: this resolves its own
# location to find the checkout and deliberately does NOT change directory, so
# claude starts in whatever project you invoked it from.
set -euo pipefail

# python3 is a hard requirement anyway, and realpath/readlink -f are not portable.
SELF="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")"
REPO="$(dirname "$SELF")"

if [ ! -x "$REPO/.venv/bin/python" ]; then
  echo "run $REPO/setup.sh first" >&2
  exit 1
fi

# The package is imported from the checkout rather than installed, so it needs
# to be on sys.path explicitly now that the working directory is the caller's.
export PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}"

if ! command -v claude >/dev/null 2>&1; then
  echo "claude is not on your PATH; install it with:" >&2
  echo "  curl -fsSL https://claude.ai/install.sh | bash" >&2
  exit 1
fi

# Ask the proxy's own config loader for these, so the launcher cannot drift from
# it on precedence or defaults.
eval "$("$REPO/.venv/bin/python" - <<'PY'
from claude_ollama import config
c = config.load()
print(f"PROXY_HOST={c.host}")
print(f"PROXY_PORT={c.port}")
print(f"MAIN_MODEL={c.default_model}")
print(f"SMALL_MODEL={c.small_model or c.default_model}")
print(f"TIMEOUT_MS={int(c.timeout * 1000)}")
print(f"NUM_CTX={c.num_ctx}")
print(f"OLLAMA={c.base_url}")
PY
)"

BASE_URL="http://${PROXY_HOST}:${PROXY_PORT}"
PROXY_PID=""

# Say it out loud: the model actually used comes from .env, not from whatever
# Claude Code's UI reports, and that difference has caused real confusion.
echo "model $MAIN_MODEL · ollama $OLLAMA · num_ctx $NUM_CTX"

# Catch the quiet failures — Ollama down, model not pulled, a proxy still running
# with an older .env — before handing over to Claude Code.
if [ "${CLAUDE_OLLAMA_SKIP_CHECKS:-0}" != "1" ]; then
  "$REPO/.venv/bin/python" -m claude_ollama.preflight || exit 1
fi

if curl -fsS -m 2 "$BASE_URL/health" >/dev/null 2>&1; then
  echo "using the proxy already running at $BASE_URL"
else
  # Redirect to a file: a background job inherits this terminal, and the proxy's
  # per-request log would otherwise be drawn straight over Claude Code's TUI.
  LOG="${CLAUDE_OLLAMA_LOG:-$REPO/proxy.log}"
  echo "starting proxy on $BASE_URL (log: $LOG)"
  "$REPO/.venv/bin/python" -m claude_ollama >>"$LOG" 2>&1 &
  PROXY_PID=$!
  trap '[ -n "$PROXY_PID" ] && kill "$PROXY_PID" 2>/dev/null || true' EXIT

  for _ in $(seq 40); do
    curl -fsS -m 2 "$BASE_URL/health" >/dev/null 2>&1 && break
    kill -0 "$PROXY_PID" 2>/dev/null || {
      echo "proxy exited during startup; last lines of $LOG:" >&2
      tail -n 15 "$LOG" >&2
      exit 1
    }
    sleep 0.25
  done
fi

# A non-empty token keeps Claude Code from trying to log in; the proxy ignores it.
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="ollama"
# Cleared so a real key already in the environment cannot take precedence.
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL="$MAIN_MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$SMALL_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MAIN_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MAIN_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$SMALL_MODEL"
export API_TIMEOUT_MS="$TIMEOUT_MS"
# Claude Code cannot look up the window of a model it does not know, assumes 200k
# and compacts at that — which would send prompts far past num_ctx for Ollama to
# truncate in silence. Keep the two windows equal.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$NUM_CTX"
# Nothing below changes where prompts go — ANTHROPIC_BASE_URL already confines
# conversation content to Ollama. These close the side channels Claude Code opens
# to Anthropic regardless of which model serves the session.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
# Also an isolation setting: the updater contacts Anthropic on its own schedule.
# The trade-off is that sessions launched this way never self-update; a plain
# `claude` elsewhere still does.
export DISABLE_AUTOUPDATER=1
# Prompt caching is deliberately left alone: the proxy ignores cache_control, and
# DISABLE_PROMPT_CACHING only earns a warning about cost and speed that does not
# apply to a local model.

# Carry the status line as session settings rather than installing it into every
# project. Flag settings outrank project ones, so this wins wherever you launch.
# CLAUDE_OLLAMA_NO_STATUSLINE=1 keeps whatever status line you already have.
SESSION_SETTINGS=""
if [ "${CLAUDE_OLLAMA_NO_STATUSLINE:-0}" != "1" ]; then
  SESSION_SETTINGS=$("$REPO/.venv/bin/python" -m claude_ollama.ide --print-settings 2>/dev/null || true)
fi

if [ -n "$SESSION_SETTINGS" ]; then
  claude --settings "$SESSION_SETTINGS" "$@"
else
  claude "$@"
fi
