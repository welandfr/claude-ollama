#!/usr/bin/env bash
# Launches Claude Code against Ollama, which serves the Anthropic Messages API
# itself at /v1/messages. Any arguments are passed through to claude.
#
# Safe to symlink onto your PATH and run from any project: this resolves its own
# location to find the checkout and deliberately does NOT change directory, so
# claude starts in whatever project you invoked it from.
set -euo pipefail

# python3 is a hard requirement anyway, and realpath/readlink -f are not portable.
SELF="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")"
REPO="$(dirname "$SELF")"

# The package is imported from the checkout rather than installed, so it needs
# to be on sys.path explicitly now that the working directory is the caller's.
export PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}"

if ! command -v claude >/dev/null 2>&1; then
  echo "claude is not on your PATH; install it with:" >&2
  echo "  curl -fsSL https://claude.ai/install.sh | bash" >&2
  exit 1
fi

# Ask the shared config loader for these, so the launcher, vscode-setup.sh and
# the startup checks cannot drift apart on precedence or defaults. shlex.quote
# because eval runs whatever comes back.
eval "$(python3 - <<'PY'
import shlex
from claude_ollama import config
c = config.load()
values = {
    "MAIN_MODEL": c.default_model,
    "SMALL_MODEL": c.small_model or c.default_model,
    "TIMEOUT_MS": int(c.timeout * 1000),
    "NUM_CTX": c.num_ctx,
    "MAX_OUTPUT": c.max_output,
    "OLLAMA": c.base_url,
}
for key, value in values.items():
    print(f"{key}={shlex.quote(str(value))}")
PY
)"

# Say where this session is going before Claude Code's interface takes over.
echo "model $MAIN_MODEL · ollama $OLLAMA · window $NUM_CTX"

# Catch the quiet failures — Ollama down, a model not pulled, stale project
# settings, a server window smaller than NUM_CTX — before handing over.
if [ "${CLAUDE_OLLAMA_SKIP_CHECKS:-0}" != "1" ]; then
  python3 -m claude_ollama.preflight || exit 1
fi

# Straight to Ollama, which speaks the Anthropic Messages API at /v1/messages. A
# non-empty token keeps Claude Code from trying to log in; Ollama ignores it.
export ANTHROPIC_BASE_URL="$OLLAMA"
export ANTHROPIC_AUTH_TOKEN="ollama"
# Cleared so a real key already in the environment cannot take precedence.
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL="$MAIN_MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$SMALL_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MAIN_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MAIN_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$SMALL_MODEL"
export API_TIMEOUT_MS="$TIMEOUT_MS"
# Claude Code cannot look up the window of a model it does not know, assumes 200k
# and compacts at that — which would send prompts far past Ollama's window, to be
# truncated in silence. Ollama's window is set on the server
# (OLLAMA_CONTEXT_LENGTH); the startup checks compare the two when they can.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$NUM_CTX"
# The /model picker's Default row otherwise resolves to "<model>[1m]", a 1M
# window that undoes the line above just as silently.
export CLAUDE_CODE_DISABLE_1M_CONTEXT=1
# Claude Code compacts at window - min(max output, 20000) - 13000. Its default
# output cap of 32000 puts that at half of a 64K window; a smaller cap moves it
# up without letting prompt plus reply outgrow the window.
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$MAX_OUTPUT"
# Nothing below changes where prompts go — ANTHROPIC_BASE_URL already confines
# conversation content to Ollama. These close the side channels Claude Code opens
# to Anthropic regardless of which model serves the session.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
# Also an isolation setting: the updater contacts Anthropic on its own schedule.
# The trade-off is that sessions launched this way never self-update; a plain
# `claude` elsewhere still does.
export DISABLE_AUTOUPDATER=1
# claude.ai connectors run through Anthropic, not Ollama, so they stay off. Saying
# so explicitly also silences the "connectors are disabled because ... another
# auth source is set" warning shown on machines logged in to claude.ai.
export ENABLE_CLAUDEAI_MCP_SERVERS=false
# Prompt caching is deliberately left alone: DISABLE_PROMPT_CACHING only earns a
# warning about cost and speed that does not apply to a local model.

# Carry the status line and the /model picker rows as session settings rather
# than installing them into every project. Flag settings outrank project ones,
# so this wins wherever you launch. The picker can only come from here: Claude
# Code ignores modelPicker in a project's .claude/.
# CLAUDE_OLLAMA_NO_STATUSLINE=1 keeps whatever status line you already have.
SETTINGS_ARGS=(--print-settings)
[ "${CLAUDE_OLLAMA_NO_STATUSLINE:-0}" = "1" ] && SETTINGS_ARGS+=(--no-statusline)
SESSION_SETTINGS=$(python3 -m claude_ollama.ide "${SETTINGS_ARGS[@]}" 2>/dev/null || true)

# Enter in /model saves the pick to ~/.claude/settings.json, where a plain
# `claude` would then ask Anthropic for an Ollama model. Put it back on exit.
USER_MODEL=$(python3 -m claude_ollama.ide --get-user-model 2>/dev/null || echo null)

STATUS=0
if [ -n "$SESSION_SETTINGS" ]; then
  claude --settings "$SESSION_SETTINGS" "$@" || STATUS=$?
else
  claude "$@" || STATUS=$?
fi
python3 -m claude_ollama.ide --restore-user-model "$USER_MODEL" || true
exit "$STATUS"
